{
  "name": "dsh-duplicate-file-check",
  "version": "0.5.0",
  "type": "module",
  "description": "小视频整理：完全一致查重、MP4 帧级近似查重、批量改名/移动、MOV/AVI/WMV 统一转 MP4；自动准备 ffmpeg。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jediliu005/dsh-duplicate-file-check.git"
  },
  "homepage": "https://github.com/jediliu005/dsh-duplicate-file-check",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "duplicate-files",
    "video-dedupe",
    "batch-rename",
    "ffmpeg",
    "mov-to-mp4"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/jediliu005/dsh-duplicate-file-check/issues"
  }
}
